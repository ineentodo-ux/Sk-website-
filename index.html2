<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SK | Sajim</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#000;
    color:#00ff66;
    font-family:"Courier New",monospace;
    min-height:100vh;
    overflow:hidden;
}

/* Matrix */
canvas{
    position:fixed;
    inset:0;
    z-index:0;
    opacity:.28;
}

.overlay{
    position:fixed;
    inset:0;
    z-index:1;
    pointer-events:none;
    background:repeating-linear-gradient(
        0deg,
        rgba(0,255,80,.04) 0px,
        rgba(0,255,80,.04) 1px,
        transparent 1px,
        transparent 4px
    );
}

/* Main */
.container{
    position:relative;
    z-index:2;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.card{
    width:100%;
    max-width:520px;
    padding:35px 25px;
    text-align:center;

    background:rgba(0,10,3,.9);
    border:1px solid #00ff66;
    border-radius:18px;

    box-shadow:
        0 0 25px rgba(0,255,80,.25),
        inset 0 0 30px rgba(0,255,80,.05);

    animation:appear 1s ease;
}

@keyframes appear{
    from{
        opacity:0;
        transform:scale(.75);
    }
    to{
        opacity:1;
        transform:scale(1);
    }
}

/* SK */
.logo-wrap{
    position:relative;
    display:inline-block;
    padding-bottom:12px;
}

.logo{
    font-size:90px;
    font-weight:900;
    letter-spacing:-8px;

    text-shadow:
        0 0 5px #00ff66,
        0 0 20px #00ff66,
        0 0 50px #00ff66;

    animation:glitch 1.8s infinite;
}

.name{
    position:absolute;
    right:-25px;
    bottom:-3px;

    font-size:18px;
    font-weight:bold;
    letter-spacing:4px;

    color:#00ff66;
    text-shadow:0 0 12px #00ff66;

    /* straight */
    transform:none;

    animation:namePulse 1.5s infinite alternate;
}

@keyframes namePulse{
    from{opacity:.65;}
    to{
        opacity:1;
        text-shadow:
            0 0 8px #00ff66,
            0 0 20px #00ff66;
    }
}

@keyframes glitch{
    0%,85%,100%{transform:translate(0);}
    88%{transform:translate(-4px,2px);}
    91%{transform:translate(4px,-2px);}
    94%{transform:translate(-2px,0);}
}

/* Status */
.status{
    margin-top:8px;
    font-size:12px;
    letter-spacing:3px;
}

.dot{
    animation:blink .7s infinite;
}

@keyframes blink{
    50%{opacity:0;}
}

h1{
    margin-top:20px;
    color:white;
    font-size:24px;
}

.subtitle{
    margin-top:10px;
    color:#70ff9c;
    font-size:13px;
    letter-spacing:2px;
}

.line{
    height:1px;
    width:100%;
    margin:24px 0;
    background:#00ff66;
    box-shadow:0 0 10px #00ff66;
}

/* Terminal */
.terminal{
    text-align:left;
    min-height:120px;
    padding:15px;

    background:#000;
    border:1px solid rgba(0,255,100,.35);
    border-radius:10px;

    font-size:12px;
    line-height:1.9;
}

/* Red alert */
.alert{
    display:none;
    margin-top:18px;
    padding:16px 10px;

    color:#ff2222;
    border:1px solid #ff2222;
    background:rgba(255,0,0,.08);

    font-size:14px;
    font-weight:bold;

    box-shadow:
        0 0 12px rgba(255,0,0,.5),
        inset 0 0 15px rgba(255,0,0,.08);

    animation:danger .45s infinite alternate;
}

@keyframes danger{
    from{
        opacity:.55;
        transform:translateX(0);
    }
    to{
        opacity:1;
        transform:translateX(2px);
    }
}

.alert.show{
    display:block;
}

.warning-icon{
    font-size:28px;
    display:block;
    margin-bottom:5px;
}

/* Button */
.btn{
    margin-top:22px;
    padding:13px 28px;

    border:0;
    border-radius:8px;

    background:#00ff66;
    color:#000;

    font-family:inherit;
    font-weight:bold;

    cursor:pointer;

    box-shadow:0 0 20px rgba(0,255,100,.4);
    transition:.3s;
}

.btn:hover{
    transform:scale(1.05);
    box-shadow:0 0 35px #00ff66;
}

.footer{
    margin-top:25px;
    color:#39734c;
    font-size:10px;
}
</style>
</head>

<body>

<canvas id="matrix"></canvas>
<div class="overlay"></div>

<div class="container">

<div class="card">

    <div class="logo-wrap">
        <div class="logo">SK</div>
        <div class="name">Sajim</div>
    </div>

    <div class="status">
        SYSTEM ONLINE <span class="dot">●</span>
    </div>

    <h1>Welcome to My World</h1>

    <p class="subtitle">
        UNKNOWN • DIGITAL • UNDEFINED
    </p>

    <div class="line"></div>

    <div class="terminal" id="terminal">
        <div>> Initializing...</div>
        <div>> Connecting...</div>
        <div>> Loading secure interface...</div>
        <div>> <span class="cursor">█</span></div>
    </div>

    <div class="alert" id="alert">
        <span class="warning-icon">⚠️</span>
        SYSTEM ALERT<br>
        CYBER SIMULATION BY SK
    </div>

    <button class="btn" onclick="startAnimation()">
        ENTER SYSTEM
    </button>

    <div class="footer">
        SK // SAJIM // 2026
    </div>

</div>
</div>

<script>

/* Matrix animation */

const canvas = document.getElementById("matrix");
const ctx = canvas.getContext("2d");

function resize(){
    canvas.width = innerWidth;
    canvas.height = innerHeight;
}

resize();
window.addEventListener("resize", resize);

const chars = "01ABCDEFGHIJKLMNOPQRSTUVWXYZ#$%@";
const size = 14;
let drops = [];

function resetDrops(){
    drops = Array(Math.floor(canvas.width / size)).fill(1);
}

resetDrops();

function matrix(){

    ctx.fillStyle = "rgba(0,0,0,.08)";
    ctx.fillRect(0,0,canvas.width,canvas.height);

    ctx.fillStyle = "#00ff66";
    ctx.font = size + "px monospace";

    for(let i=0;i<drops.length;i++){

        const char =
            chars[Math.floor(Math.random()*chars.length)];

        ctx.fillText(char,i*size,drops[i]*size);

        if(
            drops[i]*size > canvas.height &&
            Math.random() > .975
        ){
            drops[i]=0;
        }

        drops[i]++;
    }
}

setInterval(matrix,35);


/* Terminal typing */

function startAnimation(){

    const terminal =
        document.getElementById("terminal");

    const alert =
        document.getElementById("alert");

    const button =
        document.querySelector(".btn");

    alert.classList.remove("show");

    button.disabled = true;
    button.style.opacity = ".5";

    const lines = [
        "> Establishing connection...",
        "> Encrypting visual interface...",
        "> Scanning interface...",
        "> Loading SK protocol...",
        "> Access sequence complete..."
    ];

    terminal.innerHTML = "";

    let i = 0;

    const timer = setInterval(()=>{

        terminal.innerHTML +=
            "<div>" + lines[i] + "</div>";

        i++;

        if(i >= lines.length){

            clearInterval(timer);

            setTimeout(()=>{

                alert.classList.add("show");

                button.disabled = false;
                button.style.opacity = "1";

            },700);
        }

    },550);
}

</script>

</body>
</html>